# ============================================================
# 04-eks/terraform.tfvars.example — 선택 오버라이드 전용
# ============================================================
# 이 스택은 tfvars 없이 동작하도록 설계됨 (모든 변수에 기본값).
# 기본값을 바꿀 때만 terraform.tfvars 로 복사해 해당 줄 주석 해제.
#
# ⚠ my_ip 는 여기(또는 어떤 파일)에도 넣지 말 것 — 변수 취급 정책상
#   세션 환경변수 전용 채널 (README §2 세션 리추얼):
#     $env:TF_VAR_my_ip = (Invoke-RestMethod https://checkip.amazonaws.com).Trim()
#   파일 주입은 거주지 공인 IP(OPSEC 민감 식별자)를 디스크·VCS 에 남기는
#   회귀이며, tfvars 폐지 결정(2026-07)에 위배. my_ip 없이 apply 하면
#   변수 프롬프트/validation 이 막아준다 (fail-closed).
# ============================================================

# project_name                = "devsecops-project"
# cluster_name                = "joshua-eks"
# kubernetes_version          = "1.35"
# node_instance_type          = "t3.medium"
# node_desired_size           = 1     # 생성 시점 초기값 (운영 중 스케일은 CLI — 런북 §4)
# node_min_size               = 0     # CLI Pause 패턴과의 무충돌 기본값 — 변경 비권장
# node_max_size               = 3
# lb_controller_chart_version = "1.14.0"
